name: Windows build
on:
  push:
    branches: [main]
    tags: ['v*']
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  build:
    runs-on: windows-latest
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
      - name: Rust toolchain
        shell: pwsh
        run: |
          rustup toolchain install 1.99.0 --profile minimal --no-self-update
          rustup default 1.99.0
          rustup component add rustfmt clippy
          rustc -Vv
      - name: Format
        run: cargo fmt --all -- --check
      - name: Clippy
        run: cargo clippy --locked --all-targets -- -D warnings
      - name: Unit tests
        run: cargo test --locked --all-targets
      - name: Release build
        run: cargo build --locked --release
      - name: Package
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force dist/CoralSpyNext | Out-Null
          Copy-Item target/release/coralspynext.exe dist/CoralSpyNext/
          Copy-Item README.md,LICENSE,THIRD_PARTY.md dist/CoralSpyNext/
          Get-FileHash dist/CoralSpyNext/coralspynext.exe -Algorithm SHA256 | Format-List | Out-File dist/CoralSpyNext/SHA256.txt
          Compress-Archive -Path dist/CoralSpyNext -DestinationPath dist/CoralSpyNext-windows-x64.zip
      - uses: actions/upload-artifact@v4
        with:
          name: CoralSpyNext-windows-x64
          path: dist/CoralSpyNext-windows-x64.zip
          if-no-files-found: error
          retention-days: 30
